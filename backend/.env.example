# Database (SQLAlchemy 2.1 maps postgresql:// to psycopg 3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mango

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Notifications (optional). Unset topic ARN -> notifications are logged, not published.
# AWS credentials come from the standard AWS chain, never from this file.
AWS_SNS_TOPIC_ARN=
AWS_REGION=us-east-1

# AI investigation. Select one pinned provider and configure its key.
LLM_PROVIDER=gemini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
INCIDENT_HISTORY_SIMILARITY_FLOOR=0.75
INCIDENT_HISTORY_LIMIT=3
INCIDENT_HISTORY_ENABLED=true
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Provider budget. Mango never sends a request that would exceed these; it queues instead.
# The free-tier quota is PER MODEL, so these must match the model named above, and pinning a
# version beats an alias: "gemini-flash-latest" moved to gemini-3.8-flash, whose free tier
# allows 20 requests a day. The guard cannot protect a limit it was not told about. Read your
# own figures at https://aistudio.google.com/rate-limit.
LOG_LEVEL=INFO
LLM_SHOW_THINKING=true
LLM_REQUESTS_PER_MINUTE=10
LLM_REQUESTS_PER_DAY=20
LLM_MAX_RETRIES=5
LLM_COOLDOWN_SECONDS=60
LLM_QUOTA_TIMEZONE=America/Los_Angeles
REDIS_URL=redis://localhost:6379/0
INVESTIGATION_WORKER_CONCURRENCY=4
INGEST_WORKER_CONCURRENCY=4
OTEL_ENDPOINT=
SLACK_WEBHOOK_URL=

# A queued or running investigation older than this is treated as abandoned.
STALE_RUN_MINUTES=60

# Evidence source: the JSONL log file DummyCommerce writes
DUMMYCOMMERCE_LOG_PATH=../dummycommerce/logs/app.jsonl
EVIDENCE_MAX_RECORDS=50
EVIDENCE_WINDOW_MINUTES=15

# DummyCommerce reports incidents as this Mango user (register it first, in the console or
# via POST /auth/register). Leave blank and it logs the failure instead of filing it.
MANGO_EMAIL=
MANGO_PASSWORD=
